import java.time.LocalDateTime;

public class PacienteHabitacion {

    private int idPacienteHabitacion;
    private int paciente_id;
    private int habitacion_id;
    private LocalDateTime fechaIngreso;
    private LocalDateTime fechaSalida;

    public PacienteHabitacion() {}

    public PacienteHabitacion(int idPacienteHabitacion, int paciente_id, int habitacion_id) {
        this.idPacienteHabitacion = idPacienteHabitacion;
        this.paciente_id = paciente_id;
        this.habitacion_id = habitacion_id;
    }

    public int getIdPacienteHabitacion() {
        return idPacienteHabitacion;
    }

    public void setIdPacienteHabitacion(int idPacienteHabitacion) {
        this.idPacienteHabitacion = idPacienteHabitacion;
    }

    public int getPaciente_id() {
        return paciente_id;
    }

    public void setPaciente_id(int paciente_id) {
        this.paciente_id = paciente_id;
    }

    public int getHabitacion_id() {
        return habitacion_id;
    }

    public void setHabitacion_id(int habitacion_id) {
        this.habitacion_id = habitacion_id;
    }

    public LocalDateTime getFechaIngreso() {
        return fechaIngreso;
    }

    public LocalDateTime getFechaSalida() {
        return fechaSalida;
    }
    public void registrarIngreso() {
        this.fechaIngreso = LocalDateTime.now();
        System.out.println("Ingreso registrado. Fecha: " + fechaIngreso);
    }
    public void registrarSalida() {
        this.fechaSalida = LocalDateTime.now();
        System.out.println("Salida registrada. Fecha: " + fechaSalida);
    }
}
